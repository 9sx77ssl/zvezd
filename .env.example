# ------------------------------------------------------------------
# Lolz Star Bot — secrets & environment overrides
# Copy this file to `.env` and fill in the real values.
# ------------------------------------------------------------------

# Lolzteam forum API bearer token (scope must include `read` and `post`)
FORUM_TOKEN=

# Telegram API credentials from https://my.telegram.org/apps
# Run `bun run login` once to authorize the user session and store it.
TG_API_ID=
TG_API_HASH=

# --- Optional environment overrides (take precedence over config.yml) ---
# FORUM_BASE_URL=https://api.lolz.team
# FORUM_THREAD_ID=10335815
# DB_PATH=./data/star.db
# TG_SESSION_PATH=./data/tg.session
# LOG_LEVEL=info
# LOG_PRETTY=true
# STAR_COUNT=1
# POLL_INTERVAL_MS=5000
# DRY_RUN=true
