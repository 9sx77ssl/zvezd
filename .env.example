# ------------------------------------------------------------------
# zvezd — секреты.
# Скопируй файл в `.env` и заполни значения.
# Всё поведение (лимиты, задержки, тексты) — в config.yml.
# .env в git не попадает.
# ------------------------------------------------------------------

# Bearer-токен API lolzteam (права `read` и `post`).
FORUM_TOKEN=

# Данные Telegram-приложения с https://my.telegram.org/apps
# Один раз выполни `bun run login`, чтобы создать сессию.
TG_API_ID=
TG_API_HASH=
