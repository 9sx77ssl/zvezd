# ------------------------------------------------------------------
# Lolz Star Bot — секреты и переопределения окружения.
# Скопируй файл в `.env` и заполни реальные значения.
# .env в git не попадает.
# ------------------------------------------------------------------

# Bearer-токен API lolzteam (нужны права `read` и `post`).
# Берётся в настройках аккаунта lolz.team (раздел API/токены).
FORUM_TOKEN=

# Данные Telegram-приложения с https://my.telegram.org/apps
# Один раз выполни `bun run login`, чтобы создать сессию.
TG_API_ID=
TG_API_HASH=

# --- Необязательные переопределения (приоритет выше config.yml) ---
# Адрес API форума.
# FORUM_BASE_URL=https://api.lolz.team
# id темы форума, которую следим.
# FORUM_THREAD_ID=10335815
# Путь к базе SQLite.
# DB_PATH=./data/star.db
# Путь к файлу сессии Telegram (создаётся `bun run login`).
# TG_SESSION_PATH=./data/tg.session
# Уровень логов: trace/debug/info/warn/error/fatal.
# LOG_LEVEL=info
# Человекочитаемый вывод логов (true/1/yes/on).
# LOG_PRETTY=true
# Сколько звёзд ставить на пост.
# STAR_COUNT=1
# Как часто проверять новые посты, мс.
# POLL_INTERVAL_MS=5000
# Режим симуляции без трат (true/1/yes/on).
# DRY_RUN=true
